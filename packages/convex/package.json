{
  "name": "@tpx/convex",
  "version": "0.1.0",
  "private": true,
  "description": "The console's single Convex deployment: every service's tables (service-prefixed) and internal functions.",
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./schema": "./convex/schema.ts",
    "./test-modules": "./test-modules.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p convex/tsconfig.json",
    "dev": "convex dev",
    "codegen": "convex codegen",
    "deploy": "convex deploy"
  },
  "dependencies": {
    "convex": "1.46.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
