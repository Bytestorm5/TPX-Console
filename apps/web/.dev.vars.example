# Copy to .dev.vars for `pnpm dev`. Never commit .dev.vars.
# (`pnpm dev:fixture` needs none of these: fixture identity, in-memory stores.)
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# The Convex deployment every service stores in (CONVEX_URL is a var in wrangler.jsonc).
CONVEX_DEPLOY_KEY=dev:your-deployment|your-deploy-key
# The connections service's master key: 32 random bytes, base64 (`openssl rand -base64 32`).
CONNECTIONS_MASTER_KEY=
